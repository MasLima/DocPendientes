# ============================================================
# Plantilla de configuracion. Copiar a `.env` y llenar valores.
# NUNCA subir el archivo .env real (contiene claves).
# ============================================================

# --- Servidor de la API ---
PORT=3000
JWT_SECRET=cambiar_por_un_secreto_largo_aleatorio

# --- BD de la app (local en pruebas, otro servidor en produccion) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=adm.123
DB_NAME=cobranza_app

# --- ERP - SOLO LECTURA ---
# El password va entre comillas si contiene caracteres especiales (#).
ERP_HOST=dm.integrator.pe
ERP_PORT=3306
ERP_USER=coloma
ERP_PASSWORD="Coloma#Integrator"
ERP_DB=db0010_01